{
  "name": "Chimera",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "ServerStorage": {
      "DevTools": {
        "$className": "Folder",
        "BuildGraybox": {
          "$path": "tools/graybox/BuildGraybox.luau"
        },
        "BuildMapKit": {
          "$path": "tools/mapkit/BuildMapKit.luau"
        },
        "BuildMap": {
          "$path": "tools/map/BuildMap.luau"
        },
        "MapLayout": {
          "$path": "tools/map/MapLayout.luau"
        }
      }
    },

    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 14,
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": false
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
